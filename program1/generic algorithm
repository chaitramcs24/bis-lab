import random

def fitness(schedule, processing_times, num_machines):
    """
    schedule[i] = machine assigned to job i

    Returns the negative makespan because the genetic
    algorithm maximizes fitness.
    """

    machine_load = [0] * num_machines

    for job, machine in enumerate(schedule):
        machine_load[machine] += processing_times[job]

    makespan = max(machine_load)

    # Smaller makespan = better solution
    return -makespan


def create_population(num_jobs, num_machines, population_size):
    """Create random schedules."""
    population = []

    for _ in range(population_size):
        schedule = [
            random.randint(0, num_machines - 1)
            for _ in range(num_jobs)
        ]
        population.append(schedule)

    return population


def selection(population, fitness_values):
    """Tournament selection."""
    candidates = random.sample(
        range(len(population)), 3
    )

    winner = max(
        candidates,
        key=lambda i: fitness_values[i]
    )

    return population[winner]


def crossover(parent1, parent2):
    """Single-point crossover."""
    point = random.randint(1, len(parent1) - 1)

    child = parent1[:point] + parent2[point:]

    return child


def mutation(schedule, num_machines, mutation_rate):
    """Randomly change the machine assigned to a job."""
    for i in range(len(schedule)):
        if random.random() < mutation_rate:
            schedule[i] = random.randint(
                0, num_machines - 1
            )

    return schedule


def genetic_algorithm(
    processing_times,
    num_machines,
    population_size=50,
    generations=100,
    mutation_rate=0.05
):
    num_jobs = len(processing_times)

    # Initial population
    population = create_population(
        num_jobs,
        num_machines,
        population_size
    )

    for generation in range(generations):

        # Calculate fitness
        fitness_values = [
            fitness(
                schedule,
                processing_times,
                num_machines
            )
            for schedule in population
        ]

        # Keep the best solution
        best_index = max(
            range(population_size),
            key=lambda i: fitness_values[i]
        )

        best_schedule = population[best_index]
        best_fitness = fitness_values[best_index]

        # New population
        new_population = [best_schedule.copy()]

        while len(new_population) < population_size:

            # Selection
            parent1 = selection(
                population,
                fitness_values
            )

            parent2 = selection(
                population,
                fitness_values
            )

            # Crossover
            child = crossover(parent1, parent2)

            # Mutation
            child = mutation(
                child,
                num_machines,
                mutation_rate
            )

            new_population.append(child)

        population = new_population

    # Find final best solution
    fitness_values = [
        fitness(
            schedule,
            processing_times,
            num_machines
        )
        for schedule in population
    ]

    best_index = max(
        range(len(population)),
        key=lambda i: fitness_values[i]
    )

    return population[best_index]


# --------------------------------------------------
# Example
# --------------------------------------------------

processing_times = [10, 5, 8, 12, 6, 7, 4, 9]

num_machines = 3

best_schedule = genetic_algorithm(
    processing_times,
    num_machines,
    population_size=50,
    generations=200,
    mutation_rate=0.05
)


# --------------------------------------------------
# Display result
# --------------------------------------------------

machine_load = [0] * num_machines

for job, machine in enumerate(best_schedule):
    machine_load[machine] += processing_times[job]

print("Job -> Machine assignment:")

for job, machine in enumerate(best_schedule):
    print(
        f"Job {job + 1} "
        f"(time={processing_times[job]}) "
        f"-> Machine {machine + 1}"
    )

print("\nMachine loads:")

for machine, load in enumerate(machine_load):
    print(f"Machine {machine + 1}: {load}")

print("\nMakespan:", max(machine_load))
